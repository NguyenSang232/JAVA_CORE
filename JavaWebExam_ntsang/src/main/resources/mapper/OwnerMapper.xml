<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="training.javaweb.exam.mapper.OwnerMapper">

    <!-- ===================== ResultMap ===================== -->
    <resultMap id="OwnerDTOMap"
               type="training.javaweb.exam.dto.response.OwnerDTO">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="email" column="email"/>
        <result property="address" column="address"/>
        <result property="createAt" column="created_at"/>
       	<result property="deletedAt" column="deleted_at"/>
    </resultMap>

    <!-- ===================== Create ===================== -->
    <insert id="insert"
            parameterType="training.javaweb.exam.entity.Owner"
            useGeneratedKeys="true"
            keyProperty="id">

        INSERT INTO owners
        (
            name,
            phone,
            email,
            address,
            deleted_at,
            created_at,
            updated_at
        )
        VALUES
        (
            #{name},
            #{phone},
            #{email},
            #{address},
            false,
            NOW(),
            NOW()
        )

    </insert>

    <!-- ===================== Get All ===================== -->
    <select id="findAll"
            resultMap="OwnerDTOMap">

        SELECT
            o.*
        FROM owners o
        WHERE o.deleted_at = false
        ORDER BY o.id DESC

    </select>

    <!-- ===================== Detail ===================== -->
    <select id="findDetail"
            parameterType="long"
            resultMap="OwnerDTOMap">
        SELECT
            id,
            name,
            phone,
            email,
            address
        FROM owners
        WHERE id = #{id}
        <!--  AND deleted_at = false-->
    </select>
	
	
    <!-- ===================== Find By Id ===================== -->
    <select id="findDTOById"
            parameterType="long"
            resultMap="OwnerDTOMap">

        SELECT
            id,
            name,
            phone,
            email,
            address
        FROM owners
        WHERE id = #{id}
        <!--  AND deleted_at = false-->
    </select>
    <!-- ===================== Update ===================== -->
    <update id="update"
            parameterType="training.javaweb.exam.entity.Owner">

        UPDATE owners

        <set>
            <if test="name != null">
                name = #{name},
            </if>

            <if test="phone != null">
                phone = #{phone},
            </if>

            <if test="email != null">
                email = #{email},
            </if>

            <if test="address != null">
                address = #{address},
            </if>

            updated_at = NOW()
        </set>

        WHERE id = #{id}

    </update>

    <!-- ===================== Search ===================== -->
    <select id="search"
            resultMap="OwnerDTOMap">

        SELECT
            id,
            name,
            phone,
            email,
            address
        FROM owners

        WHERE deleted_at = false
          AND (
                name LIKE CONCAT('%', #{keyword}, '%')
                OR phone LIKE CONCAT('%', #{keyword}, '%')
              )

        ORDER BY id DESC

    </select>

    <!-- ===================== Soft Delete ===================== -->
    <update id="softDelete">

        UPDATE owners
        SET
            deleted_at = true,
            updated_at = NOW()
        WHERE id = #{id}

    </update>

</mapper>