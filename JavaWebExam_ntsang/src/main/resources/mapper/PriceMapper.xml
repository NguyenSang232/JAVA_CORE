<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="training.javaweb.exam.repository.PriceMapper">

    <!-- 1. Định nghĩa ResultMap bao gồm cả các trường cân nặng -->
    <resultMap id="PriceResultMap" type="training.javaweb.exam.entity.Price">
        <id property="id" column="id" />
        <result property="petType" column="pet_type" />
        <result property="weightFrom" column="weight_from" />
        <result property="weightTo" column="weight_to" />
        <result property="basePrice" column="base_price" />
    </resultMap>

    <!-- 2. Định nghĩa đầy đủ các cột để tái sử dụng -->
    <sql id="priceColumns">
        id, pet_type, weight_from, weight_to, base_price
    </sql>

    <!-- 3. Lấy thông tin giá theo ID -->
    <select id="findById" parameterType="java.lang.Long" resultMap="PriceResultMap">
        SELECT 
            <include refid="priceColumns"/>
        FROM tbl_price
        WHERE id = #{id}
    </select>

    <!-- 4. Lấy đơn giá nền dựa vào Loại thú cưng VÀ Số cân nặng thực tế -->
    <select id="findByPetTypeAndWeight" resultMap="PriceResultMap">
        SELECT 
            <include refid="priceColumns"/>
        FROM tbl_price
        WHERE LOWER(pet_type) = LOWER(#{petType})
          AND #{weight} &gt;= weight_from
          AND #{weight} &lt;= weight_to
    </select>

    <!-- 5. Lấy toàn bộ danh sách cấu hình giá -->
    <select id="findAll" resultMap="PriceResultMap">
        SELECT 
            <include refid="priceColumns"/>
        FROM tbl_price
    </select>

    <!-- 6. Thêm mới cấu hình giá (Bao gồm cả khoảng cân nặng) -->
    <insert id="save" parameterType="training.javaweb.exam.entity.Price" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tbl_price (pet_type, weight_from, weight_to, base_price)
        VALUES (#{petType}, #{weightFrom}, #{weightTo}, #{basePrice})
    </insert>

    <!-- 7. Cập nhật cấu hình giá sống (Dynamic Update) -->
    <update id="update" parameterType="training.javaweb.exam.entity.Price">
        UPDATE tbl_price
        <set>
            <if test="petType != null">pet_type = #{petType},</if>
            <if test="weightFrom != null">weight_from = #{weightFrom},</if>
            <if test="weightTo != null">weight_to = #{weightTo},</if>
            <if test="basePrice != null">base_price = #{basePrice}</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 8. Xóa cấu hình giá -->
    <delete id="deleteById" parameterType="java.lang.Long">
        DELETE FROM tbl_price WHERE id = #{id}
    </delete>

</mapper>